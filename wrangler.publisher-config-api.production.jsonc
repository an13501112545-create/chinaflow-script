{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chinaflow-config-api-v0-1",
  "main": "publisher-platform/config-api-worker-v0.1.mjs",
  "compatibility_date": "2026-08-14",
  "rules": [
    {
      "type": "Text",
      "globs": ["loader-v0.3.js", "chinaflow-v0.6.js"],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "CHINAFLOW_EVENTS",
      "database_name": "chinaflow-events-v0-1",
      "database_id": "838917da-3fb8-437e-bc00-caff178798e8",
      "migrations_dir": "collector/migrations"
    }
  ]
}
