{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chinaflow-auth-api-v0-1-test",
  "main": "publisher-platform/auth-api-worker-v0.1.mjs",
  "compatibility_date": "2026-08-14",
  "d1_databases": [
    {
      "binding": "CHINAFLOW_EVENTS",
      "database_name": "chinaflow-events-v0-1-test",
      "database_id": "f8c07a5f-f9e7-4595-9f25-ce3d525241d9",
      "migrations_dir": "collector/migrations"
    }
  ],
  "vars": {
    "AUTH_ENVIRONMENT": "test",
    "AUTH_TEST_EMAIL": "an13501112545@gmail.com"
  },
  "ratelimits": [
    {
      "name": "MAGIC_LINK_EMAIL_RATE_LIMITER",
      "namespace_id": "26091201",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "MAGIC_LINK_IP_RATE_LIMITER",
      "namespace_id": "26091202",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
