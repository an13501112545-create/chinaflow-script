{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chinaflow-publisher-app-v0-1-test",
  "main": "publisher-platform/app-worker-v0.1.mjs",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "d1_databases": [
    {
      "binding": "CHINAFLOW_EVENTS",
      "database_name": "chinaflow-events-v0-1-test",
      "database_id": "f8c07a5f-f9e7-4595-9f25-ce3d525241d9",
      "migrations_dir": "collector/migrations"
    }
  ],
  "vars": {
    "APP_ENVIRONMENT": "test",
    "APP_ORIGIN": "https://chinaflow-publisher-app-v0-1-test.an13501112545.workers.dev",
    "CHINAFLOW_AUTH_ORIGIN": "https://chinaflow-auth-api-v0-1-test.an13501112545.workers.dev",
    "CHINAFLOW_RUNTIME_ORIGIN": "https://chinaflow-config-api-v0-1-test.an13501112545.workers.dev",
    "OWNER_CLAIM_RELEASE_ENABLED": "true",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "PUBLISHER_REPORTING_QUERY_ENABLED": "true",
    "AGENT_BOOKING_ENABLED": "true"
  },
  "ratelimits": [
    {
      "name": "VERIFY_INSTALL_SESSION_RATE_LIMITER",
      "namespace_id": "26092311",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "VERIFY_INSTALL_IP_RATE_LIMITER",
      "namespace_id": "26092312",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
